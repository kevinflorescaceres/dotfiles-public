    "git.confirmSync": false,
    "editor.tabSize": 2,
    "diffEditor.ignoreTrimWhitespace": false,
    "cSpell.language": "en,es-ES",
    "editor.minimap.enabled": false,
    "[ruby]": {
        "editor.defaultFormatter": "lorankloeze.ruby-rubocop-revived"
    },
    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "keep",
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        }
    },
    "gitlens.views.repositories.files.layout": "list",
    "gitlens.views.repositories.showStashes": true,
    "docker.extension.enableComposeLanguageServer": false,
    "chat.instructionsFilesLocations": {
        ".github/instructions": true,
        ".claude/rules": true,
        "~/.copilot/instructions": true,
        "~/.claude/rules": true,
        "/tmp/postman-http-request-post-response.instructions.md": true,
        "/tmp/postman-http-request-pre-request.instructions.md": true,
        "/tmp/postman-collections-post-response.instructions.md": true,
        "/tmp/postman-collections-pre-request.instructions.md": true,
        "/tmp/postman-folder-post-response.instructions.md": true,
        "/tmp/postman-folder-pre-request.instructions.md": true
    },
    "mssql.connectionGroups": [
        {
            "name": "ROOT",
            "id": "ROOT"
        }
    ],
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "mssql.autoDisableNonTSqlLanguageService": false,
"logFileHighlighter.customPatterns": [
  { "pattern": "\\[M\\]", "foreground": "#4aa3ff", "fontWeight": "bold" },
  { "pattern": "\\[C\\]", "foreground": "#ff9f43", "fontWeight": "bold" },

  { "pattern": "\\[CALCULATE_VALUES\\]", "foreground": "#00bcd4", "fontWeight": "bold" },
  { "pattern": "\\[CALCULATE_TIP_AND_CHANGE\\]", "foreground": "#8bc34a", "fontWeight": "bold" },
  { "pattern": "\\[VALIDATE_PAID_IN_FULL_CLOSED\\]", "foreground": "#ff9800", "fontWeight": "bold" },
  { "pattern": "\\[REMOVE_RENDITION_TENDERS\\]", "foreground": "#f06292", "fontWeight": "bold" },

  { "pattern": "\\[CREATE\\]", "foreground": "#26a69a", "fontWeight": "bold" },
  { "pattern": "\\[REMOVE\\]", "foreground": "#ef5350", "fontWeight": "bold" },
  { "pattern": "\\[ADD_AMOUNT\\]", "foreground": "#ab47bc", "fontWeight": "bold" },

  { "pattern": "state=\\[OPEN\\]", "foreground": "#f1c40f" },
  { "pattern": "state=\\[FULFILLED\\]", "foreground": "#2ecc71" },
  { "pattern": "state=\\[CLOSED\\]", "foreground": "#e74c3c" }
],
"chat.disableAIFeatures": true
}
