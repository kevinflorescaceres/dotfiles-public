{
  "model": "opus[1m]",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(ls -d \"$HOME\"/.claude/plugins/cache/ponytail/ponytail/*/hooks/ponytail-statusline.sh 2>/dev/null | sort -V | tail -1)\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoMode": {
    "environment": [
      "$defaults",
      "**Organization**: {COMPANY}. Primary use: {PRIMARY_USE}",
      "**Source control**: {e.g. bitbucket.org/your-workspace and every repo under it}",
      "**Cloud provider(s)**: {e.g. AWS: Elastic Beanstalk, S3 + CloudFront}",
      "**Secrets management**: {e.g. Rails encrypted credentials, .env files}"
    ],
    "soft_deny": [
      "$defaults",
      "{e.g. Writes/DROP against any non-local database}"
    ]
  }
}
